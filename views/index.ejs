<%- include('partials/header.ejs'); -%>

  <div class="divider"></div>
  <div class="heading-users" id="heading" data-color="<%= color %>">
      <form class="tab-users" action="/user" method="post" >
        <label for="user-select">User: </label>
        <select id="user-select" name="user" onchange="this.form.submit()">
        <% users.forEach(function(user) { %>
            <option value="<%= user.id %>" <%= user.id == currentUser.id ? "selected" : "" %>>
              <%= user.name %>
            </option>
          <% }) %>
        </select>
      </form>

      <form class="add-user" action="/new" method="post" >
          <button class="add" type="submit" name="add" value="new"  > +</button>
      </form>
  </div>


    <div class="box heading" id="heading"  data-color="<%= color %>">
      <h1>
        Day
      </h1>
    </div>
  <div class="box">
    <% for (let item of taskDay){%>
      <div class="item" >
        <form action="/delete" method="post">
          <input type="hidden" name="list" value="Day">
          <input type="checkbox" onchange="this.form.submit()" name="deleteItemIdDay" value="<%= item.id %>" aria-label="Complete day item">
        </form>

        
        <p id="title-day-<%=item.id%>">
          <%= item.title %>
        </p>
      
        <form class="edit" action="/edit" method="post">
          <input type="hidden" name="updatedItemIdDay" value="<%= item.id %>">
          <input type="hidden" name="list" value="Day">
          <input id="input-day-<%=item.id%>" type="text" name="updatedItemTitleDay" value="<%= item.title %>" autocomplete="off"
            autofocus="true" hidden="true" aria-label="Edit day item" />
          <button id="done-day-<%=item.id%>" class="edit" type="submit" hidden><img class="icon"
              src="/assets/icons/check-solid.svg" alt="tick image"></button>
        </form>
        <button id="edit-day-<%=item.id%>" class="edit" onclick="handler('day', '<%=item.id%>')"><img class="icon"
            src="/assets/icons/pencil-solid.svg" alt="pencil image"></button>
      </div>
      <% } %>

        <form class="item" action="/add" method="post">
          <input type="text" name="newItemDay" placeholder="Add a new day item" aria-label="New day item" autocomplete="off" autofocus="true"  required />
          <button class="add" type="submit" name="list" value="Day" >+</button>
        </form>
  </div>
  <div class="box heading"  id="heading" data-color="<%= color %>">
    
    <h1>
      Week
    </h1>
  </div>
  <div class="box">
    <% for (let item of taskWeek){%>
      <div class="item">
        <form action="/delete" method="post">
          <input type="hidden" name="list" value="Week">
          <input type="checkbox" onchange="this.form.submit()" name="deleteItemIdWeek" value="<%= item.id %>" aria-label="Complete week item">
        </form>

        
        <p id="title-week-<%=item.id%>">
          <%= item.title %>
        </p>
        <form class="edit" action="/edit" method="post">
              <input type="hidden" name="updatedItemIdWeek" value="<%= item.id %>">
              <input type="hidden" name="list" value="Week">
              <input id="input-week-<%=item.id%>" type="text" name="updatedItemTitleWeek" value="<%= item.title %>" autocomplete="off"
                autofocus="true" hidden="true" aria-label="Edit week item" />
              <button id="done-week-<%=item.id%>" class="edit" type="submit" hidden><img class="icon"
                  src="/assets/icons/check-solid.svg" alt="tick image"></button>
            </form>
            <button id="edit-week-<%=item.id%>" class="edit" onclick="handler('week', '<%=item.id%>')"><img class="icon"
                src="/assets/icons/pencil-solid.svg" alt="pencil image"></button>
          </div>
          <% } %>

            <form class="item" action="/add" method="post">
              <input type="text" name="newItemWeek" placeholder="Add a new week item" aria-label="New week item" autocomplete="off" autofocus="true"  required />
              <button class="add" type="submit" name="list" value="Week" >+</button>
            </form>
  </div>
  <div class="box heading" id="heading"  data-color="<%= color %>">
    <h1>
      Month
    </h1>
  </div>
  <div class="box">
    <% for (let item of taskMonth){%>
      <div class="item">
        <form action="/delete" method="post">
          <input type="hidden" name="list" value="Month">
          <input type="checkbox" onchange="this.form.submit()" name="deleteItemIdMonth" value="<%= item.id %>" aria-label="Complete month item">
        </form>
        <p id="title-month-<%=item.id%>">
          <%= item.title %>
        </p>
        <form class="edit" action="/edit" method="post">
          <input type="hidden" name="updatedItemIdMonth" value="<%= item.id %>">
          <input type="hidden" name="list" value="Month">
          <input id="input-month-<%=item.id%>" type="text" name="updatedItemTitleMonth" value="<%= item.title %>" autocomplete="off"
            autofocus="true" hidden="true" aria-label="Edit month item" />
          <button id="done-month-<%=item.id%>" class="edit" type="submit" hidden><img class="icon"
              src="/assets/icons/check-solid.svg" alt="tick image"></button>
        </form>
        <button id="edit-month-<%=item.id%>" class="edit" onclick="handler('month', '<%=item.id%>')"><img class="icon"
            src="/assets/icons/pencil-solid.svg" alt="pencil image"></button>
      </div>
      <% } %>
        <form class="item" action="/add" method="post">
          <input type="text" name="newItemMonth" placeholder="Add a new month item" aria-label="New month item" autocomplete="off" autofocus="true"  required />
          <button class="add" type="submit" name="list" value="Month" >+</button>
        </form>
  </div>
  <script>
    function handler(list, id) {
      document.getElementById("title-" + list + "-" + id).hidden = true ;
      document.getElementById("edit-"  + list + "-" + id).hidden = true ;
      document.getElementById("done-"  + list + "-" + id).hidden = false ;
      document.getElementById("input-" + list + "-" + id).hidden = false ;
    }  
    document.querySelectorAll("[data-color]").forEach(function (element) {
      element.style.backgroundColor = element.dataset.color;
    });
    const currentColor = document.querySelector("[data-color]").dataset.color;
    document.documentElement.style.setProperty("--user-color", currentColor);

  </script>
  
  <%- include('partials/footer.ejs'); -%>